---
import Photo from "../components/Photo.astro";

type Props = {
  title: string;
  alt: string;
  tint?: string; // optional Tailwind class, e.g. "hue-rotate-[250deg]"
};

const { title, alt, tint = "" } = Astro.props;
---

<section class="relative isolate flex min-h-[240px] items-center justify-center md:min-h-[340px]">
  <Photo
    src="/images/placeholder.svg"
    alt={alt}
    fill
    priority
    sizes="100vw"
    class={`-z-20 object-cover ${tint}`}
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/35"></div>
  <h1 class="font-display text-5xl font-bold text-white md:text-7xl">{title}</h1>
</section>
