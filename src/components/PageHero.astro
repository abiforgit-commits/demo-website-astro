---
type Props = { eyebrow?: string; title: string; intro?: string };

const { eyebrow, title, intro } = Astro.props;
---

<section class="bg-ink px-6 pb-16 pt-36 md:pb-24 md:pt-44 lg:px-10">
  <div class="mx-auto max-w-7xl">
    {eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-widest text-brand">{eyebrow}</p>
    )}
    <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-tight md:text-6xl">
      {title}
    </h1>
    {intro && (
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-white/70">{intro}</p>
    )}
  </div>
</section>
